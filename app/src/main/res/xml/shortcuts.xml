<?xml version="1.0" encoding="utf-8"?>
<!-- 长按桌面图标出现的快捷方式 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_connect"
        android:shortcutId="connect"
        android:shortcutLongLabel="@string/shortcut_connect"
        android:shortcutShortLabel="@string/shortcut_connect">
        <intent
            android:action="com.easyclash.action.CONNECT"
            android:targetClass="com.easyclash.ui.ShortcutActivity"
            android:targetPackage="com.easyclash" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_disconnect"
        android:shortcutId="disconnect"
        android:shortcutLongLabel="@string/shortcut_disconnect"
        android:shortcutShortLabel="@string/shortcut_disconnect">
        <intent
            android:action="com.easyclash.action.DISCONNECT"
            android:targetClass="com.easyclash.ui.ShortcutActivity"
            android:targetPackage="com.easyclash" />
    </shortcut>
</shortcuts>
